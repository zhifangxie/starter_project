{
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Edit/Write tool used!'"
          }
        ]
      }
    ]
  }
}
